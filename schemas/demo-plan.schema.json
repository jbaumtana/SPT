{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Demo plan",
  "description": "The approval artifact. Generated from a prospect brief and the context layer. Nothing is built until approval.approved_by is set by a human SE.",
  "type": "object",
  "required": ["prospect", "playbook", "story", "screens", "data_to_generate", "tenant_actions", "approval"],
  "properties": {
    "prospect": { "type": "string" },
    "playbook": { "type": "string", "description": "Path to the context/playbooks file used" },
    "story": { "type": "string", "description": "One-paragraph narrative: the pains, in order, and how the demo resolves them" },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["screen", "answers_pain"],
        "properties": {
          "screen": { "type": "string" },
          "answers_pain": { "type": "string" },
          "minutes": { "type": "number" }
        }
      }
    },
    "data_to_generate": {
      "type": "object",
      "properties": {
        "brands_and_profiles": { "type": "array", "items": { "type": "string" } },
        "posts": { "type": "integer" },
        "campaigns": { "type": "array", "items": { "type": "string" } },
        "inbox_messages": { "type": "integer" },
        "sentiment_mix": { "type": "string", "description": "e.g. '70/20/10 pos/neu/neg, one negative cluster about billing'" },
        "listening_topics": { "type": "array", "items": { "type": "string" } },
        "reports": { "type": "array", "items": { "type": "string" } }
      }
    },
    "brand_kit": {
      "type": "object",
      "properties": {
        "use_prospect_logo": { "type": "boolean" },
        "colors": { "type": "array", "items": { "type": "string" } },
        "voice_notes": { "type": "string" }
      }
    },
    "overlay_visuals": {
      "type": "object",
      "description": "Charts and images the overlay swaps on screen. Both are off unless listed here and approved. Sample data only: never described as the prospect's real results (CLAUDE.md rule 4). Replacements are drawn from the data pack, so numbers on tiles and charts tie out.",
      "properties": {
        "charts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["report", "chart", "type", "shows"],
            "properties": {
              "report": { "type": "string", "description": "Report name exactly as listed in Reports (context/tenant-index-ui.md)" },
              "chart": { "type": "string", "description": "Key in app-map.json screens.reports.charts" },
              "type": { "enum": ["bar", "line", "donut"] },
              "shows": { "type": "string", "description": "What the drawn chart shows and which pain it answers, e.g. 'monthly impressions rising after launch'" },
              "kpis": { "type": "array", "items": { "type": "string" }, "description": "KPI tile keys that read from this chart's numbers" }
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["screen", "target", "action"],
            "properties": {
              "screen": { "type": "string" },
              "target": { "type": "string", "description": "Key in app-map.json screens.<screen>.images" },
              "action": { "enum": ["swap", "hide"] },
              "replacement": { "enum": ["monogram", "generated", "none"], "description": "none when action is hide" },
              "why": { "type": "string", "description": "What is off-message about the original image" }
            }
          }
        }
      }
    },
    "tenant_actions": {
      "type": "array",
      "description": "Everything that would touch a tenant. Empty in Phase 1.",
      "items": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "route": { "enum": ["api", "browser-seed", "overlay", "manual"] },
          "reversible_by": { "type": "string" }
        }
      }
    },
    "risks_and_landmines": { "type": "array", "items": { "type": "string" } },
    "approval": {
      "type": "object",
      "required": ["approved_by"],
      "properties": {
        "approved_by": { "type": ["string", "null"], "description": "Human SE name. null = not approved" },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "edits_requested": { "type": "string" }
      }
    }
  }
}
